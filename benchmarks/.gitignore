# Bulky per-file hypothesis caches and ephemeral run outputs are not committed.
# Committed: code, manifests/ (id lists + provenance), date-stamped summary
# results, and the final numbers that land in docs/BENCHMARKS.md.
results_full/
results/*__latest.json
__pycache__/
*.pyc

# Local smoke-corpus audio copies (regenerable from the corpus, not committed)
results/*/smoke-vox*/
