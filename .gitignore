# Rust
/target
# Cargo.lock is committed: polyvoice ships CLI binaries, Python wheels, and C FFI
# artifacts, so reproducible, lockfile-pinned builds and supply-chain checks matter.

# IDEs
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log

# Test artifacts
/tests/output/
*.wav
*.mp3
*.flac
# Tiny audio-io decode fixtures (checked in on purpose).
!tests/data/audio-io/
!tests/data/audio-io/**
# e2e + native Vox-3 smoke clips (short, checked in so CI can fail closed).
!tests/data/e2e-smoke/
!tests/data/e2e-smoke/**
!tests/data/native-vox3/
!tests/data/native-vox3/**

# ONNX model files (should be downloaded, not committed)
*.onnx
# External-weight blobs (e.g. ecapa_tdnn*.onnx.data) — route via manifest+signing,
# never commit. Were ~252 MB of orphan in-tree weights.
*.onnx.data

# M5 — quantization tooling artifacts (downloaded data + INT8 build outputs + venv)
.venv-m5/
data/voxconverse-dev/audio/
data/voxconverse-dev/rttm/
data/voxceleb1-subset/wav/
data/voxceleb1-subset/lists/
models/int8/*.onnx
models/int8/*.onnx.data

# Benchmark data and results
/data/
/bench-results/

# Secrets / credentials
.env
.env.*
*.pem
*.key
*.p8
*.p12
id_rsa
id_rsa.pub

# AI agent working directories (keep repo self-contained regardless of global gitignore)
.claude/
.cody/
.cursor/
.omc/
.omx/
.continue/
.aider*

# Local git worktrees
.worktrees/

# Local tool caches (model downloads etc.)
.cache/

# Python caches
__pycache__/
*.pyc
*.pyo

# Design specs / plans that should not be committed
/docs/superpowers/

# Python stale native extensions
python/polyvoice/_polyvoice.cpython-*.so
python/polyvoice/_polyvoice.cpython-*.dylib
python/polyvoice/_polyvoice.cpython-*.dll

# cargo-kimi artifacts
.kimi/
kimi-score.svg
mutants.out/
benchmark_kmeans*
cobertura.xml

# local quant experiment outputs (not release artifacts)
models/int8/candidates/

# Compiled BNNSGraph cache (regenerate via scripts/export-resnet-bnns-graph.py)
*.mlmodelc/
*.mlpackage/
*.bnnsgraph
